{
  "manifest_version": 3,
  "name": "ClipSync - Block de Notas en Tiempo Real",
  "version": "1.0.0",
  "description": "Selecciona cualquier texto en la web y guárdalo instantáneamente en tu block de notas de ClipSync con un solo clic flotante sincronizado con Supabase.",
  "icons": {
    "16": "favicon.svg",
    "48": "favicon.svg",
    "128": "favicon.svg"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Abrir ClipSync Block de Notas"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
